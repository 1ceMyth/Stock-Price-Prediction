from flask import Flask, render_template, request, url_for
import yfinance as yf
import pandas as pd
from sklearn.linear_model import LinearRegression
import matplotlib.pyplot as plt
import os

app = Flask(__name__)

@app.route("/", methods=["GET", "POST"])
def index():
    if request.method == "POST":
        ticker = request.form["ticker"]
        df = yf.download(ticker, period="60d", interval="1d")

        if df.empty:
            return render_template("index.html", error="Invalid ticker symbol!")

        df = df.reset_index()
        df["Date"] = df["Date"].map(pd.Timestamp.toordinal)
        X = df[["Date"]]
        y = df["Close"]

        model = LinearRegression()
        model.fit(X, y)

        future_date = df["Date"].max() + 1
        prediction = model.predict([[future_date]])

        # Save plot
        plt.figure(figsize=(10, 4))
        plt.plot(df["Date"], y, label="Actual")
        plt.plot(df["Date"], model.predict(X), label="Trend", linestyle="--")
        plt.title(f"{ticker.upper()} Stock Price")
        plt.xlabel("Date")
        plt.ylabel("Price")
        plt.legend()
        plt.tight_layout()
        
        os.makedirs("static", exist_ok=True)
        graph_filename = "plot.png"
        graph_path = os.path.join("static", graph_filename)
        plt.savefig(graph_path)
        plt.close()

        # Use url_for to generate the correct path for the HTML template
        graph_url = url_for("static", filename=graph_filename)

        return render_template(
            "result.html",
            ticker=ticker.upper(),
            prediction=round(float(prediction[0]), 2),
            graph=graph_url
        )

    return render_template("index.html")

if __name__ == "__main__":
    app.run(debug=True)
