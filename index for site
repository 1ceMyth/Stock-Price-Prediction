<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Stock Price Predictor</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
      color: white;
      min-height: 100vh;
    }
    .card {
      background-color: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(8px);
      border-radius: 1rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .form-control {
      background-color: rgba(255, 255, 255, 0.2);
      color: white;
      border: none;
    }
    .form-control::placeholder {
      color: rgba(255, 255, 255, 0.7);
    }
    .form-control:focus {
      box-shadow: none;
      background-color: rgba(255, 255, 255, 0.3);
    }
    .btn-primary {
      background-color: #00c6ff;
      border: none;
    }
    .btn-primary:hover {
      background-color: #0072ff;
    }
  </style>
</head>
<body>
  <div class="container d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="card p-5 shadow w-100" style="max-width: 500px;">
      <h2 class="text-center mb-4">📈 Stock Price Predictor</h2>
      {% if error %}
        <div class="alert alert-danger">{{ error }}</div>
      {% endif %}
      <form method="post">
        <div class="mb-3">
          <label class="form-label">Enter Stock Ticker Symbol</label>
          <input type="text" name="ticker" class="form-control" placeholder="e.g. AAPL, MSFT" required>
        </div>
        <button type="submit" class="btn btn-primary w-100">Predict</button>
      </form>
    </div>
  </div>
</body>
</html>
