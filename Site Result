<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ ticker }} Stock Prediction</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: #f8f9fa;
            color: #333;
        }
        .container {
            margin-top: 50px;
        }
        .card {
            border: none;
            box-shadow: 0 8px 16px rgba(0,0,0,0.1);
            border-radius: 16px;
        }
        .prediction-value {
            font-size: 2rem;
            font-weight: bold;
            color: #0d6efd;
        }
        .illustration {
            max-width: 200px;
        }
        .graph-img {
            border-radius: 12px;
            max-width: 100%;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        .stock-graph-row {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            gap: 30px;
        }
    </style>
</head>
<body>
    <div class="container text-center">
        <img src="https://cdn-icons-png.flaticon.com/512/3534/3534066.png" alt="stock icon" class="illustration mb-4">
        <h1 class="mb-4">{{ ticker }} Stock Prediction</h1>
        
        <div class="card p-4 mb-4">
            <h2>Predicted Price for Tomorrow</h2>
            <p class="prediction-value">${{ prediction }}</p>
        </div>

        <h4 class="mb-3">Trend Visualization</h4>
        <div class="stock-graph-row mb-4">
            <img src="https://cdn-icons-png.flaticon.com/512/942/942748.png" alt="Graph icon" class="illustration">
            <img src="{{ graph }}" alt="Stock graph" class="graph-img">
        </div>

        <div class="mt-5">
            <h5 class="mb-3">Analytics Insight</h5>
            <img src="https://cdn-icons-png.flaticon.com/512/2706/2706964.png" class="illustration" alt="Analytics illustration">
        </div>

        <div class="mt-4">
            <a href="/" class="btn btn-primary">Predict Another Stock</a>
        </div>
    </div>
</body>
</html>
